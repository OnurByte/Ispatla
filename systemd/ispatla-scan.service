[Unit]
Description=Ispatla source discovery and scoring scan
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/makavelli/Ispatla
Environment=PATH=%h/.bun/bin:/usr/local/bin:/usr/bin
EnvironmentFile=-%h/.config/ispatla/worker.env
ExecStart=/usr/bin/flock -n %t/ispatla-scan.lock %h/.bun/bin/bun run automation:scan
